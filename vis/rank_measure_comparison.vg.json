{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Country rankings by total FIDE-rated players and rated players per million residents.",
  "width": "container",
  "height": 450,
  "background": "#FBF7EF",
  "data": {
    "url": "data/rank_measure_comparison.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rated_players": "number",
        "population": "number",
        "population_year": "number",
        "players_per_million": "number",
        "total_rank": "number",
        "per_million_rank": "number",
        "rank_difference": "number",
        "display_order": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#CBBBA7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "total_rank",
          "type": "quantitative",
          "scale": {
            "domain": [1, 200],
            "nice": false
          },
          "axis": {
            "title": "Global rank (1 = highest)",
            "values": [1, 25, 50, 75, 100, 125, 150, 175, 200],
            "format": "d",
            "labelFont": "Inter, Arial, sans-serif",
            "titleFont": "Inter, Arial, sans-serif",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "labelColor": "#66574B",
            "titleColor": "#33261E",
            "labelPadding": 7,
            "titlePadding": 12,
            "domain": false,
            "tickColor": "#CBBBA7",
            "grid": true,
            "gridColor": "#E9DFD2"
          }
        },
        "x2": {
          "field": "per_million_rank"
        },
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "display_order",
            "order": "ascending"
          },
          "axis": {
            "title": null,
            "labelFont": "Inter, Arial, sans-serif",
            "labelFontSize": 12,
            "labelColor": "#33261E",
            "labelPadding": 10,
            "labelLimit": 180,
            "domain": false,
            "ticks": false
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "total_rank",
            "type": "quantitative",
            "format": "d",
            "title": "Rank by total players"
          },
          {
            "field": "per_million_rank",
            "type": "quantitative",
            "format": "d",
            "title": "Rank by players per million"
          },
          {
            "field": "rated_players",
            "type": "quantitative",
            "format": ",d",
            "title": "FIDE-rated players"
          },
          {
            "field": "players_per_million",
            "type": "quantitative",
            "format": ",.1f",
            "title": "Players per million residents"
          },
          {
            "field": "rank_difference",
            "type": "quantitative",
            "format": "d",
            "title": "Rank difference (per million − total)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": ["total_rank", "per_million_rank"],
          "as": ["rank_measure", "rank"]
        },
        {
          "calculate": "datum.rank_measure === 'total_rank' ? 'Total players' : 'Players per million'",
          "as": "measure_label"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "size": 115,
        "stroke": "#FBF7EF",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [1, 200],
            "nice": false
          }
        },
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "display_order",
            "order": "ascending"
          }
        },
        "color": {
          "field": "measure_label",
          "type": "nominal",
          "scale": {
            "domain": ["Total players", "Players per million"],
            "range": ["#9B6D4B", "#587887"]
          },
          "legend": {
            "title": "Ranking measure",
            "orient": "top",
            "direction": "horizontal",
            "titleFont": "Inter, Arial, sans-serif",
            "labelFont": "Inter, Arial, sans-serif",
            "titleFontSize": 12,
            "labelFontSize": 12,
            "titleColor": "#33261E",
            "labelColor": "#66574B",
            "symbolType": "circle",
            "symbolSize": 100,
            "padding": 4
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "total_rank",
            "type": "quantitative",
            "format": "d",
            "title": "Rank by total players"
          },
          {
            "field": "per_million_rank",
            "type": "quantitative",
            "format": "d",
            "title": "Rank by players per million"
          },
          {
            "field": "rated_players",
            "type": "quantitative",
            "format": ",d",
            "title": "FIDE-rated players"
          },
          {
            "field": "players_per_million",
            "type": "quantitative",
            "format": ",.1f",
            "title": "Players per million residents"
          },
          {
            "field": "rank_difference",
            "type": "quantitative",
            "format": "d",
            "title": "Rank difference (per million − total)"
          },
          {
            "field": "measure_label",
            "type": "nominal",
            "title": "Point represents"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}
